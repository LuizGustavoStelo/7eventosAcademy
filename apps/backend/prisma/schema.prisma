generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER       @map("user")
  ADMIN      @map("admin")
  SUPERADMIN @map("superadmin")

  @@map("user_role")
}

enum ClassStatus {
  PLANNING         @map("planning")
  ENROLLMENTS_OPEN @map("enrollments_open")
  IN_PROGRESS      @map("in_progress")
  CLOSED           @map("closed")

  @@map("class_status")
}

enum EnrollmentStatus {
  ACTIVE    @map("active")
  CANCELED  @map("canceled")
  COMPLETED @map("completed")

  @@map("enrollment_status")
}

enum ChargeStatus {
  PENDING  @map("pending")
  PAID     @map("paid")
  OVERDUE  @map("overdue")
  CANCELED @map("canceled")

  @@map("charge_status")
}

enum TransactionStatus {
  PENDING  @map("pending")
  SUCCESS  @map("success")
  FAILED   @map("failed")
  REFUNDED @map("refunded")

  @@map("transaction_status")
}

enum CreditCardPaymentRequestStatus {
  WAITING_COURSE_START @map("waiting_course_start")
  REQUESTED @map("requested")
  LINK_SENT @map("link_sent")
  VIEWED    @map("viewed")
  COPIED    @map("copied")
  APPROVED  @map("approved")
  CANCELED  @map("canceled")

  @@map("credit_card_payment_request_status")
}

enum MonthlyChargeKind {
  COURSE_PAYMENT @map("course_payment")
  ENROLLMENT_FEE @map("enrollment_fee")

  @@map("monthly_charge_kind")
}

enum CourseStatus {
  ACTIVE   @map("active")
  DRAFT    @map("draft")
  INACTIVE @map("inactive")

  @@map("course_status")
}

enum CourseModality {
  PRESENTIAL @map("presencial")
  HYBRID     @map("hibrido")
  EAD        @map("ead")

  @@map("course_modality")
}

enum CoursePaymentModel {
  CASH         @map("cash")
  INSTALLMENTS @map("installments")

  @@map("course_payment_model")
}

enum FinanceVoucherDiscountType {
  PERCENT @map("percent")
  FIXED   @map("fixed")

  @@map("finance_voucher_discount_type")
}

enum FinanceVoucherAppliesTo {
  TOTAL       @map("total")
  INSTALLMENT @map("installment")

  @@map("finance_voucher_applies_to")
}

enum FinanceVoucherInstallmentScope {
  ALL    @map("all")
  SINGLE @map("single")

  @@map("finance_voucher_installment_scope")
}

enum UploadOwnerType {
  COURSE     @map("course")
  USER       @map("user")
  STUDENT    @map("student")
  CLASS      @map("class")
  ENROLLMENT @map("enrollment")

  @@map("upload_owner_type")
}

enum StudentCourseStatus {
  INTERESTED @map("interested")
  ACTIVE     @map("active")
  COMPLETED  @map("completed")
  CANCELED   @map("canceled")

  @@map("student_course_status")
}

enum InstitutionStatus {
  ACTIVE    @map("active")
  INACTIVE  @map("inactive")
  SUSPENDED @map("suspended")

  @@map("institution_status")
}

enum InstitutionMemberStatus {
  ACTIVE    @map("active")
  INVITED   @map("invited")
  SUSPENDED @map("suspended")

  @@map("institution_member_status")
}

enum ContractTemplateStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  ARCHIVED  @map("archived")

  @@map("contract_template_status")
}

enum ContractInstanceStatus {
  SENT         @map("sent")
  VIEWED       @map("viewed")
  PIN_VERIFIED @map("pin_verified")
  SIGNED       @map("signed")
  EXPIRED      @map("expired")
  ARCHIVED     @map("archived")
  CANCELED     @map("canceled")

  @@map("contract_instance_status")
}

model User {
  id             String         @id @default(uuid()) @db.Uuid
  ownerAdminId   String?        @map("owner_admin_id") @db.Uuid
  institutionId  String?        @map("institution_id") @db.Uuid
  name           String
  email          String         @unique
  passwordHash   String         @map("password_hash")
  role           UserRole       @default(ADMIN)
  emailConfirmedAt DateTime?    @map("email_confirmed_at")
  emailVerificationTokenHash String? @map("email_verification_token_hash")
  emailVerificationTokenExpiresAt DateTime? @map("email_verification_token_expires_at")
  emailVerificationEmailSentAt DateTime? @map("email_verification_email_sent_at")
  passwordResetCodeHash String? @map("password_reset_code_hash")
  passwordResetCodeExpiresAt DateTime? @map("password_reset_code_expires_at")
  passwordResetCodeSentAt DateTime? @map("password_reset_code_sent_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  enrollments    Enrollment[]
  studentProfile StudentProfile?
  studentCourses StudentCourse[]
  ownedCourses   Course[]       @relation("course_owner")
  ownerAdmin     User?          @relation("admin_students", fields: [ownerAdminId], references: [id], onDelete: SetNull)
  ownedStudents  User[]         @relation("admin_students")
  institution    Institution?   @relation("institution_students", fields: [institutionId], references: [id], onDelete: SetNull)
  institutionMembers InstitutionMember[]
  financialConfig AccountFinancialConfig?
  ownedMonthlyCharges MonthlyCharge[] @relation("monthly_charge_owner")
  classNoticeViews ClassNoticeView[]
  createdContractTemplates ContractTemplate[] @relation("contract_template_created_by")
  updatedContractTemplates ContractTemplate[] @relation("contract_template_updated_by")
  publishedContractTemplateVersions ContractTemplateVersion[] @relation("contract_template_version_published_by")
  studentContractInstances ContractInstance[] @relation("contract_instance_student")
  createdContractInstances ContractInstance[] @relation("contract_instance_created_by")
  contractAuditEntries ContractAuditLog[] @relation("contract_audit_actor")
  institutionAuditEntries InstitutionAuditLog[] @relation("institution_audit_actor")
  ownedFinanceVouchers FinanceVoucher[] @relation("finance_voucher_owner")
  requestedCreditCardPayments CreditCardPaymentRequest[] @relation("credit_card_payment_request_student")
  approvedCreditCardPayments CreditCardPaymentRequest[] @relation("credit_card_payment_request_approved_by")
  ownedCreditCardPaymentRequests CreditCardPaymentRequest[] @relation("credit_card_payment_request_owner")

  @@index([ownerAdminId], map: "users_owner_admin_idx")
  @@index([institutionId], map: "users_institution_idx")
  @@map("users")
}

model Institution {
  id           String               @id @default(uuid()) @db.Uuid
  name         String
  slug         String               @unique
  status       InstitutionStatus    @default(ACTIVE)
  brandingLogoUrl String?           @map("branding_logo_url")
  brandingPalette Json?             @map("branding_palette")
  supportContactEmail String?       @map("support_contact_email")
  supportContactPhone String?       @map("support_contact_phone")
  commercialContactEmail String?    @map("commercial_contact_email")
  commercialContactPhone String?    @map("commercial_contact_phone")
  legalName             String?     @map("legal_name")
  documentCnpj          String?     @map("document_cnpj")
  address               String?     @map("address")
  contractCity          String?     @map("contract_city")
  contractForum         String?     @map("contract_forum")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  members      InstitutionMember[]
  roles        InstitutionRole[]
  students     User[]               @relation("institution_students")
  courses      Course[]
  classes      SchoolClass[]
  studentCourses StudentCourse[]
  enrollments  Enrollment[]
  contractTemplates ContractTemplate[]
  contractTemplateVersions ContractTemplateVersion[]
  contractInstances ContractInstance[]
  contractSigningTokens ContractSigningToken[]
  contractAuditLogs ContractAuditLog[]
  contractArtifacts ContractArtifact[]
  financeVouchers FinanceVoucher[]
  auditLogs      InstitutionAuditLog[]
  integrations  InstitutionIntegration[]
  integrationDispatchLogs InstitutionIntegrationDispatchLog[]
  creditCardPaymentRequests CreditCardPaymentRequest[]

  @@index([status], map: "institutions_status_idx")
  @@map("institutions")
}

model InstitutionIntegration {
  id               String      @id @default(uuid()) @db.Uuid
  institutionId    String      @map("institution_id") @db.Uuid
  provider         String
  environment      String      @default("production")
  isActive         Boolean     @default(false) @map("is_active")
  encryptedSettings String?    @map("encrypted_settings")
  lastSuccessAt    DateTime?   @map("last_success_at")
  lastErrorAt      DateTime?   @map("last_error_at")
  lastErrorMessage String?     @map("last_error_message")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  institution      Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  dispatchLogs     InstitutionIntegrationDispatchLog[]

  @@unique([institutionId, provider], map: "institution_integrations_institution_provider_key")
  @@index([provider], map: "institution_integrations_provider_idx")
  @@index([institutionId], map: "institution_integrations_institution_idx")
  @@map("institution_integrations")
}

model InstitutionIntegrationDispatchLog {
  id                String      @id @default(uuid()) @db.Uuid
  institutionId     String      @map("institution_id") @db.Uuid
  integrationId     String?     @map("integration_id") @db.Uuid
  provider          String
  status            String
  studentId         String?     @map("student_id") @db.Uuid
  studentName       String      @map("student_name")
  enrollmentId      String?     @map("enrollment_id") @db.Uuid
  contractInstanceId String?    @map("contract_instance_id") @db.Uuid
  requestPayload    Json?       @map("request_payload")
  responsePayload   Json?       @map("response_payload")
  responseStatusCode Int?       @map("response_status_code")
  errorMessage      String?     @map("error_message")
  createdAt         DateTime    @default(now()) @map("created_at")
  institution       Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  integration       InstitutionIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@index([institutionId, provider, createdAt], map: "inst_int_dispatch_inst_prov_created_idx")
  @@index([integrationId, createdAt], map: "inst_int_dispatch_integration_created_idx")
  @@index([contractInstanceId], map: "inst_int_dispatch_contract_instance_idx")
  @@map("institution_integration_dispatch_logs")
}

model InstitutionMember {
  id             String                  @id @default(uuid()) @db.Uuid
  institutionId  String                  @map("institution_id") @db.Uuid
  userId         String                  @map("user_id") @db.Uuid
  status         InstitutionMemberStatus @default(ACTIVE)
  joinedAt       DateTime?               @map("joined_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  institution    Institution              @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberRoles    MemberRole[]

  @@unique([institutionId, userId], map: "institution_members_institution_user_key")
  @@index([userId], map: "institution_members_user_idx")
  @@index([institutionId, status], map: "institution_members_institution_status_idx")
  @@map("institution_members")
}

model Permission {
  id             String           @id @default(uuid()) @db.Uuid
  code           String           @unique
  description    String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]

  @@map("permissions")
}

model InstitutionRole {
  id              String           @id @default(uuid()) @db.Uuid
  institutionId   String           @map("institution_id") @db.Uuid
  code            String
  name            String
  isSystem        Boolean          @default(false) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  institution     Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  memberRoles     MemberRole[]

  @@unique([institutionId, code], map: "institution_roles_institution_code_key")
  @@index([institutionId], map: "institution_roles_institution_idx")
  @@map("institution_roles")
}

model RolePermission {
  roleId        String          @map("role_id") @db.Uuid
  permissionId  String          @map("permission_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at")
  role          InstitutionRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "role_permissions_permission_idx")
  @@map("role_permissions")
}

model MemberRole {
  memberId      String           @map("member_id") @db.Uuid
  roleId        String           @map("role_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")
  member        InstitutionMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role          InstitutionRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([memberId, roleId])
  @@index([roleId], map: "member_roles_role_idx")
  @@map("member_roles")
}

model InstitutionAuditLog {
  id           String      @id @default(uuid()) @db.Uuid
  institutionId String     @map("institution_id") @db.Uuid
  actorUserId  String?     @map("actor_user_id") @db.Uuid
  action       String
  resourceType String      @map("resource_type")
  resourceId   String?     @map("resource_id") @db.Uuid
  metadata     Json?
  createdAt    DateTime    @default(now()) @map("created_at")
  institution  Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  actorUser    User?       @relation("institution_audit_actor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([institutionId, createdAt], map: "institution_audit_logs_institution_created_idx")
  @@index([actorUserId, createdAt], map: "institution_audit_logs_actor_created_idx")
  @@index([resourceType, createdAt], map: "institution_audit_logs_resource_type_created_idx")
  @@map("institution_audit_logs")
}

model AccountFinancialConfig {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  provider          String   @default("manual")
  environment       String   @default("sandbox")
  isActive          Boolean  @default(false) @map("is_active")
  encryptedSettings String?  @map("encrypted_settings")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([provider], map: "account_financial_configs_provider_idx")
  @@map("account_financial_configs")
}

model Course {
  id                String             @id @default(uuid()) @db.Uuid
  ownerAdminId      String             @map("owner_admin_id") @db.Uuid
  institutionId     String             @map("institution_id") @db.Uuid
  name              String
  description       String?
  category          String?
  coordinator       String?
  kobayashiOfertaCursoId String?      @map("kobayashi_oferta_curso_id")
  workloadHours     Int?               @map("workload_hours")
  price             Decimal?           @db.Decimal(12, 2)
  paymentModel      CoursePaymentModel @default(CASH) @map("payment_model")
  enrollmentFee     Decimal?           @map("enrollment_fee") @db.Decimal(12, 2)
  installmentMonths Int?               @map("installment_months")
  installmentValue  Decimal?           @map("installment_value") @db.Decimal(12, 2)
  installmentStartDate DateTime?       @map("installment_start_date")
  paymentOptions    Json?              @map("payment_options")
  enrollmentPaymentOptions Json?       @map("enrollment_payment_options")
  modality          CourseModality     @default(PRESENTIAL)
  status            CourseStatus       @default(ACTIVE)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  institution       Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  ownerAdmin        User               @relation("course_owner", fields: [ownerAdminId], references: [id], onDelete: Cascade)
  classes           SchoolClass[]
  studentCourses    StudentCourse[]
  contractInstances ContractInstance[]
  financeVouchers   FinanceVoucher[]

  @@index([ownerAdminId], map: "courses_owner_admin_idx")
  @@index([institutionId], map: "courses_institution_idx")
  @@map("courses")
}

model StudentProfile {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @unique @map("user_id") @db.Uuid
  documentCpf   String?   @unique @map("document_cpf")
  documentRg    String?   @map("document_rg")
  issuingAuthority String? @map("issuing_authority")
  phone         String?
  birthDate     DateTime? @map("birth_date")
  birthCity     String?   @map("birth_city")
  maritalStatus String?   @map("marital_status")
  gender        String?
  fatherName    String?   @map("father_name")
  motherName    String?   @map("mother_name")
  graduation    String?
  graduationConclusionYear Int? @map("graduation_conclusion_year")
  companyName   String?   @map("company_name")
  jobTitle      String?   @map("job_title")
  guardianName  String?   @map("guardian_name")
  guardianPhone String?   @map("guardian_phone")
  zipCode       String?   @map("zip_code")
  street        String?
  streetNumber  String?   @map("street_number")
  complement    String?
  neighborhood  String?
  city          String?
  state         String?
  country       String?
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model StudentCourse {
  id                                String              @id @default(uuid()) @db.Uuid
  studentId                         String              @map("student_id") @db.Uuid
  courseId                          String              @map("course_id") @db.Uuid
  institutionId                     String              @map("institution_id") @db.Uuid
  selectedPaymentOptionId           String?             @map("selected_payment_option_id")
  selectedPaymentOption             Json?               @map("selected_payment_option")
  selectedEnrollmentPaymentOptionId String?             @map("selected_enrollment_payment_option_id")
  selectedEnrollmentPaymentOption   Json?               @map("selected_enrollment_payment_option")
  enrollmentFeePaidAt               DateTime?           @map("enrollment_fee_paid_at")
  coursePaymentPaidAt               DateTime?           @map("course_payment_paid_at")
  status                            StudentCourseStatus @default(INTERESTED)
  createdAt                         DateTime            @default(now()) @map("created_at")
  updatedAt                         DateTime            @updatedAt @map("updated_at")
  institution                       Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student                           User                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course                            Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creditCardPaymentRequests         CreditCardPaymentRequest[]

  @@unique([studentId, courseId])
  @@index([studentId], map: "student_courses_student_idx")
  @@index([courseId], map: "student_courses_course_idx")
  @@index([institutionId], map: "student_courses_institution_idx")
  @@index([selectedPaymentOptionId], map: "student_courses_selected_payment_option_idx")
  @@index([selectedEnrollmentPaymentOptionId], map: "student_courses_selected_enrollment_payment_option_idx")
  @@map("student_courses")
}

model UploadAsset {
  id           String          @id @default(uuid()) @db.Uuid
  storagePath  String          @unique @map("storage_path")
  originalName String          @map("original_name")
  mimeType     String          @map("mime_type")
  sizeBytes    Int             @map("size_bytes")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  bindings     UploadBinding[]

  @@map("upload_assets")
}

model UploadBinding {
  id        String          @id @default(uuid()) @db.Uuid
  ownerType UploadOwnerType @map("owner_type")
  ownerId   String          @map("owner_id") @db.Uuid
  kind      String
  assetId   String          @map("asset_id") @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  asset     UploadAsset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([ownerType, ownerId, kind], map: "upload_bindings_owner_kind_key")
  @@index([ownerType, ownerId], map: "upload_bindings_owner_idx")
  @@map("upload_bindings")
}

model SchoolClass {
  id            String          @id @default(uuid()) @db.Uuid
  courseId      String          @map("course_id") @db.Uuid
  institutionId String          @map("institution_id") @db.Uuid
  name          String
  totalSeats    Int             @map("total_seats")
  occupiedSeats Int             @default(0) @map("occupied_seats")
  autoEnrollNewStudents Boolean @default(true) @map("auto_enroll_new_students")
  status        ClassStatus     @default(ENROLLMENTS_OPEN)
  startDate     DateTime?       @map("start_date")
  endDate       DateTime?       @map("end_date")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  institution   Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  course        Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollments   Enrollment[]
  studyMaterials StudyMaterial[]
  classNotices  ClassNotice[]
  lives         Live[]
  contractInstances ContractInstance[]

  @@index([institutionId], map: "classes_institution_idx")
  @@map("classes")
}

model Enrollment {
  id             String           @id @default(uuid()) @db.Uuid
  classId        String           @map("class_id") @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  institutionId  String           @map("institution_id") @db.Uuid
  selectedPaymentOptionId String? @map("selected_payment_option_id")
  selectedPaymentOption Json?     @map("selected_payment_option")
  selectedEnrollmentPaymentOptionId String? @map("selected_enrollment_payment_option_id")
  selectedEnrollmentPaymentOption Json? @map("selected_enrollment_payment_option")
  status         EnrollmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  institution    Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  schoolClass    SchoolClass      @relation(fields: [classId], references: [id], onDelete: Cascade)
  student        User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  monthlyCharges MonthlyCharge[]
  contractInstances ContractInstance[]
  creditCardPaymentRequests CreditCardPaymentRequest[]

  @@unique([classId, studentId])
  @@index([institutionId], map: "enrollments_institution_idx")
  @@index([selectedPaymentOptionId], map: "enrollments_selected_payment_option_idx")
  @@index([selectedEnrollmentPaymentOptionId], map: "enrollments_selected_enrollment_payment_option_idx")
  @@map("enrollments")
}

model ContractTemplate {
  id                  String                @id @default(uuid()) @db.Uuid
  institutionId       String                @map("institution_id") @db.Uuid
  name                String
  description         String?
  status              ContractTemplateStatus @default(DRAFT)
  draftTitle          String                @map("draft_title")
  draftHtmlContent    String                @map("draft_html_content")
  autoSendEnabled     Boolean               @default(false) @map("auto_send_enabled")
  autoSendAllCourses  Boolean               @default(true) @map("auto_send_all_courses")
  autoSendCourseIds   Json?                 @map("auto_send_course_ids")
  latestVersionNumber Int                   @default(0) @map("latest_version_number")
  publishedAt         DateTime?             @map("published_at")
  institutionSignedAt DateTime?             @map("institution_signed_at")
  institutionSignedByUserId String?         @map("institution_signed_by_user_id") @db.Uuid
  institutionSignedByName String?           @map("institution_signed_by_name")
  createdByUserId     String                @map("created_by_user_id") @db.Uuid
  updatedByUserId     String                @map("updated_by_user_id") @db.Uuid
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  institution         Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdByUser       User                  @relation("contract_template_created_by", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUser       User                  @relation("contract_template_updated_by", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  versions            ContractTemplateVersion[]
  instances           ContractInstance[]

  @@index([institutionId], map: "contract_templates_institution_idx")
  @@index([institutionId, status], map: "contract_templates_institution_status_idx")
  @@map("contract_templates")
}

model ContractTemplateVersion {
  id                String            @id @default(uuid()) @db.Uuid
  institutionId     String            @map("institution_id") @db.Uuid
  templateId        String            @map("template_id") @db.Uuid
  versionNumber     Int               @map("version_number")
  title             String
  htmlContent       String            @map("html_content")
  placeholdersJson  Json?             @map("placeholders_json")
  contentHash       String            @map("content_hash")
  publishedByUserId String            @map("published_by_user_id") @db.Uuid
  publishedAt       DateTime          @map("published_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  institution       Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  template          ContractTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  publishedByUser   User              @relation("contract_template_version_published_by", fields: [publishedByUserId], references: [id], onDelete: Restrict)
  instances         ContractInstance[]

  @@unique([templateId, versionNumber], map: "contract_template_versions_template_version_key")
  @@index([institutionId], map: "contract_template_versions_institution_idx")
  @@map("contract_template_versions")
}

model ContractInstance {
  id                        String               @id @default(uuid()) @db.Uuid
  institutionId             String               @map("institution_id") @db.Uuid
  templateId                String               @map("template_id") @db.Uuid
  templateVersionId         String               @map("template_version_id") @db.Uuid
  studentId                 String               @map("student_id") @db.Uuid
  enrollmentId              String?              @map("enrollment_id") @db.Uuid
  courseId                  String?              @map("course_id") @db.Uuid
  classId                   String?              @map("class_id") @db.Uuid
  status                    ContractInstanceStatus @default(SENT)
  sentAt                    DateTime             @default(now()) @map("sent_at")
  viewedAt                  DateTime?            @map("viewed_at")
  signedAt                  DateTime?            @map("signed_at")
  archivedAt                DateTime?            @map("archived_at")
  archivedReason            String?              @map("archived_reason")
  snapshotTemplateTitle     String               @map("snapshot_template_title")
  snapshotTemplateHtml      String               @map("snapshot_template_html")
  snapshotStudentData       Json?                @map("snapshot_student_data")
  unsignedHtmlSnapshot      String               @map("unsigned_html_snapshot")
  signedHtmlSnapshot        String?              @map("signed_html_snapshot")
  unsignedContentHash       String               @map("unsigned_content_hash")
  signedContentHash         String?              @map("signed_content_hash")
  signedPdfHash             String?              @map("signed_pdf_hash")
  signatureCode             String               @map("signature_code")
  acceptedTermsText         String?              @map("accepted_terms_text")
  acceptedTermsVersion      String?              @map("accepted_terms_version")
  acceptedAt                DateTime?            @map("accepted_at")
  signerIp                  String?              @map("signer_ip")
  signerUserAgent           String?              @map("signer_user_agent")
  signerTimezone            String?              @map("signer_timezone")
  signerOtpChannel          String?              @map("signer_otp_channel")
  signerOtpDestinationMasked String?             @map("signer_otp_destination_masked")
  createdByUserId           String               @map("created_by_user_id") @db.Uuid
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")
  institution               Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  template                  ContractTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersion           ContractTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  student                   User                 @relation("contract_instance_student", fields: [studentId], references: [id], onDelete: Cascade)
  enrollment                Enrollment?          @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  course                    Course?              @relation(fields: [courseId], references: [id], onDelete: SetNull)
  schoolClass               SchoolClass?         @relation(fields: [classId], references: [id], onDelete: SetNull)
  createdByUser             User                 @relation("contract_instance_created_by", fields: [createdByUserId], references: [id], onDelete: Restrict)
  signingTokens             ContractSigningToken[]
  auditLogs                 ContractAuditLog[]
  artifacts                 ContractArtifact[]

  @@unique([signatureCode], map: "contract_instances_signature_code_key")
  @@index([institutionId], map: "contract_instances_institution_idx")
  @@index([institutionId, studentId], map: "contract_instances_institution_student_idx")
  @@index([institutionId, status], map: "contract_instances_institution_status_idx")
  @@index([templateId], map: "contract_instances_template_idx")
  @@map("contract_instances")
}

model ContractSigningToken {
  id                String          @id @default(uuid()) @db.Uuid
  institutionId     String          @map("institution_id") @db.Uuid
  contractInstanceId String         @map("contract_instance_id") @db.Uuid
  tokenHash         String          @map("token_hash")
  expiresAt         DateTime        @map("expires_at")
  usedAt            DateTime?       @map("used_at")
  otpChannel        String          @default("email") @map("otp_channel")
  otpDestination    String?         @map("otp_destination")
  pinHash           String?         @map("pin_hash")
  pinExpiresAt      DateTime?       @map("pin_expires_at")
  pinAttempts       Int             @default(0) @map("pin_attempts")
  pinLastAttemptAt  DateTime?       @map("pin_last_attempt_at")
  pinBlockedUntil   DateTime?       @map("pin_blocked_until")
  verifiedAt        DateTime?       @map("verified_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  institution       Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  contractInstance  ContractInstance @relation(fields: [contractInstanceId], references: [id], onDelete: Cascade)
  auditLogs         ContractAuditLog[]

  @@unique([tokenHash], map: "contract_signing_tokens_token_hash_key")
  @@index([institutionId], map: "contract_signing_tokens_institution_idx")
  @@index([contractInstanceId], map: "contract_signing_tokens_instance_idx")
  @@index([expiresAt], map: "contract_signing_tokens_expires_at_idx")
  @@map("contract_signing_tokens")
}

model ContractAuditLog {
  id                    String              @id @default(uuid()) @db.Uuid
  institutionId         String              @map("institution_id") @db.Uuid
  contractInstanceId    String              @map("contract_instance_id") @db.Uuid
