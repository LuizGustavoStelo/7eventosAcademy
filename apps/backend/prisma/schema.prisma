  updatedAt             DateTime          @updatedAt @map("updated_at")
  monthlyCharge         MonthlyCharge     @relation(fields: [monthlyChargeId], references: [id], onDelete: Cascade)

  @@unique([externalTransactionId])
  @@map("payment_transactions")
}

