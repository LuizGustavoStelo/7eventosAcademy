  contractInstance      ContractInstance    @relation(fields: [contractInstanceId], references: [id], onDelete: Cascade)
  contractSigningToken  ContractSigningToken? @relation(fields: [contractSigningTokenId], references: [id], onDelete: SetNull)
  actorUser             User?               @relation("contract_audit_actor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([institutionId], map: "contract_audit_logs_institution_idx")
  @@index([contractInstanceId], map: "contract_audit_logs_instance_idx")
  @@index([contractSigningTokenId], map: "contract_audit_logs_token_idx")
  @@index([createdAt], map: "contract_audit_logs_created_at_idx")
  @@map("contract_audit_logs")
}

model ContractArtifact {
