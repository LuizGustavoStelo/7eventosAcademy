model FinanceVoucher {
  id                      String                    @id @default(uuid()) @db.Uuid
  institutionId           String                    @map("institution_id") @db.Uuid
  ownerAdminId            String?                   @map("owner_admin_id") @db.Uuid
  courseId                String?                   @map("course_id") @db.Uuid
  code                    String
  title                   String?
  discountType            FinanceVoucherDiscountType @map("discount_type")
  discountValue           Decimal                   @map("discount_value") @db.Decimal(12, 2)
  appliesTo               FinanceVoucherAppliesTo   @map("applies_to")
  appliesToEnrollmentFee  Boolean                   @default(false) @map("applies_to_enrollment_fee")
  installmentScope        FinanceVoucherInstallmentScope @default(ALL) @map("installment_scope")
  maxUses                 Int?                      @map("max_uses")
