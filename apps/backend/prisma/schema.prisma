generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER       @map("user")
  ADMIN      @map("admin")
  SUPERADMIN @map("superadmin")

  @@map("user_role")
}

enum ClassStatus {
  PLANNING         @map("planning")
  ENROLLMENTS_OPEN @map("enrollments_open")
  IN_PROGRESS      @map("in_progress")
  CLOSED           @map("closed")

  @@map("class_status")
}

enum EnrollmentStatus {
  ACTIVE    @map("active")
  CANCELED  @map("canceled")
  COMPLETED @map("completed")

  @@map("enrollment_status")
}

enum ChargeStatus {
  PENDING  @map("pending")
  PAID     @map("paid")
  OVERDUE  @map("overdue")
  CANCELED @map("canceled")

  @@map("charge_status")
}

enum TransactionStatus {
  PENDING  @map("pending")
  SUCCESS  @map("success")
  FAILED   @map("failed")
  REFUNDED @map("refunded")

  @@map("transaction_status")
}

enum CourseStatus {
  ACTIVE   @map("active")
  DRAFT    @map("draft")
  INACTIVE @map("inactive")

  @@map("course_status")
}

enum CourseModality {
  PRESENTIAL @map("presencial")
  HYBRID     @map("hibrido")
  EAD        @map("ead")

  @@map("course_modality")
}

enum CoursePaymentModel {
  CASH         @map("cash")
  INSTALLMENTS @map("installments")

  @@map("course_payment_model")
}

enum UploadOwnerType {
  COURSE     @map("course")
  USER       @map("user")
  STUDENT    @map("student")
  CLASS      @map("class")
  ENROLLMENT @map("enrollment")

  @@map("upload_owner_type")
}

enum StudentCourseStatus {
  INTERESTED @map("interested")
  ACTIVE     @map("active")
  COMPLETED  @map("completed")
  CANCELED   @map("canceled")

  @@map("student_course_status")
}

enum InstitutionStatus {
  ACTIVE    @map("active")
  INACTIVE  @map("inactive")
  SUSPENDED @map("suspended")

  @@map("institution_status")
}

enum InstitutionMemberStatus {
  ACTIVE    @map("active")
  INVITED   @map("invited")
  SUSPENDED @map("suspended")

  @@map("institution_member_status")
}

model User {
  id             String         @id @default(uuid()) @db.Uuid
  ownerAdminId   String?        @map("owner_admin_id") @db.Uuid
  institutionId  String?        @map("institution_id") @db.Uuid
  name           String
  email          String         @unique
  passwordHash   String         @map("password_hash")
  role           UserRole       @default(ADMIN)
  emailConfirmedAt DateTime?    @map("email_confirmed_at")
  emailVerificationCodeHash String? @map("email_verification_code_hash")
  emailVerificationCodeExpiresAt DateTime? @map("email_verification_code_expires_at")
  emailVerificationCodeSentAt DateTime? @map("email_verification_code_sent_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  enrollments    Enrollment[]
  studentProfile StudentProfile?
  studentCourses StudentCourse[]
  ownedCourses   Course[]       @relation("course_owner")
  ownerAdmin     User?          @relation("admin_students", fields: [ownerAdminId], references: [id], onDelete: SetNull)
  ownedStudents  User[]         @relation("admin_students")
  institution    Institution?   @relation("institution_students", fields: [institutionId], references: [id], onDelete: SetNull)
  institutionMembers InstitutionMember[]
  financialConfig AccountFinancialConfig?
  ownedMonthlyCharges MonthlyCharge[] @relation("monthly_charge_owner")
  classNoticeViews ClassNoticeView[]

  @@index([ownerAdminId], map: "users_owner_admin_idx")
  @@index([institutionId], map: "users_institution_idx")
  @@map("users")
}

model Institution {
  id           String               @id @default(uuid()) @db.Uuid
  name         String
  slug         String               @unique
  status       InstitutionStatus    @default(ACTIVE)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  members      InstitutionMember[]
  roles        InstitutionRole[]
  students     User[]               @relation("institution_students")
  courses      Course[]
  classes      SchoolClass[]
  studentCourses StudentCourse[]
  enrollments  Enrollment[]

  @@index([status], map: "institutions_status_idx")
  @@map("institutions")
}

model InstitutionMember {
  id             String                  @id @default(uuid()) @db.Uuid
  institutionId  String                  @map("institution_id") @db.Uuid
  userId         String                  @map("user_id") @db.Uuid
  status         InstitutionMemberStatus @default(ACTIVE)
  joinedAt       DateTime?               @map("joined_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  institution    Institution              @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberRoles    MemberRole[]

  @@unique([institutionId, userId], map: "institution_members_institution_user_key")
  @@index([userId], map: "institution_members_user_idx")
  @@index([institutionId, status], map: "institution_members_institution_status_idx")
  @@map("institution_members")
}

model Permission {
  id             String           @id @default(uuid()) @db.Uuid
  code           String           @unique
  description    String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]

  @@map("permissions")
}

model InstitutionRole {
  id              String           @id @default(uuid()) @db.Uuid
  institutionId   String           @map("institution_id") @db.Uuid
  code            String
  name            String
  isSystem        Boolean          @default(false) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  institution     Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  memberRoles     MemberRole[]

  @@unique([institutionId, code], map: "institution_roles_institution_code_key")
  @@index([institutionId], map: "institution_roles_institution_idx")
  @@map("institution_roles")
}

model RolePermission {
  roleId        String          @map("role_id") @db.Uuid
  permissionId  String          @map("permission_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at")
  role          InstitutionRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "role_permissions_permission_idx")
  @@map("role_permissions")
}

model MemberRole {
  memberId      String           @map("member_id") @db.Uuid
  roleId        String           @map("role_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")
  member        InstitutionMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role          InstitutionRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([memberId, roleId])
  @@index([roleId], map: "member_roles_role_idx")
  @@map("member_roles")
}

model AccountFinancialConfig {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  provider          String   @default("manual")
  environment       String   @default("sandbox")
  isActive          Boolean  @default(false) @map("is_active")
  encryptedSettings String?  @map("encrypted_settings")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([provider], map: "account_financial_configs_provider_idx")
  @@map("account_financial_configs")
}

model Course {
  id                String             @id @default(uuid()) @db.Uuid
  ownerAdminId      String             @map("owner_admin_id") @db.Uuid
  institutionId     String             @map("institution_id") @db.Uuid
  name              String
  description       String?
  category          String?
  coordinator       String?
  workloadHours     Int?               @map("workload_hours")
  price             Decimal?           @db.Decimal(12, 2)
  paymentModel      CoursePaymentModel @default(CASH) @map("payment_model")
  installmentMonths Int?               @map("installment_months")
  installmentValue  Decimal?           @map("installment_value") @db.Decimal(12, 2)
  modality          CourseModality     @default(PRESENTIAL)
  status            CourseStatus       @default(ACTIVE)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  institution       Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  ownerAdmin        User               @relation("course_owner", fields: [ownerAdminId], references: [id], onDelete: Cascade)
  classes           SchoolClass[]
  studentCourses    StudentCourse[]

  @@index([ownerAdminId], map: "courses_owner_admin_idx")
  @@index([institutionId], map: "courses_institution_idx")
  @@map("courses")
}

model StudentProfile {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @unique @map("user_id") @db.Uuid
  documentCpf   String?   @unique @map("document_cpf")
  phone         String?
  birthDate     DateTime? @map("birth_date")
  gender        String?
  guardianName  String?   @map("guardian_name")
  guardianPhone String?   @map("guardian_phone")
  zipCode       String?   @map("zip_code")
  street        String?
  streetNumber  String?   @map("street_number")
  complement    String?
  neighborhood  String?
  city          String?
  state         String?
  country       String?
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model StudentCourse {
  id        String            @id @default(uuid()) @db.Uuid
  studentId String            @map("student_id") @db.Uuid
  courseId  String            @map("course_id") @db.Uuid
  institutionId String        @map("institution_id") @db.Uuid
  status    StudentCourseStatus @default(INTERESTED)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  institution Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student   User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course    Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId], map: "student_courses_student_idx")
  @@index([courseId], map: "student_courses_course_idx")
  @@index([institutionId], map: "student_courses_institution_idx")
  @@map("student_courses")
}

model UploadAsset {
  id           String          @id @default(uuid()) @db.Uuid
  storagePath  String          @unique @map("storage_path")
  originalName String          @map("original_name")
  mimeType     String          @map("mime_type")
  sizeBytes    Int             @map("size_bytes")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  bindings     UploadBinding[]

  @@map("upload_assets")
}

model UploadBinding {
  id        String          @id @default(uuid()) @db.Uuid
  ownerType UploadOwnerType @map("owner_type")
  ownerId   String          @map("owner_id") @db.Uuid
  kind      String
  assetId   String          @map("asset_id") @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  asset     UploadAsset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([ownerType, ownerId, kind], map: "upload_bindings_owner_kind_key")
  @@index([ownerType, ownerId], map: "upload_bindings_owner_idx")
  @@map("upload_bindings")
}

model SchoolClass {
  id            String          @id @default(uuid()) @db.Uuid
  courseId      String          @map("course_id") @db.Uuid
  institutionId String          @map("institution_id") @db.Uuid
  name          String
  totalSeats    Int             @map("total_seats")
  occupiedSeats Int             @default(0) @map("occupied_seats")
  status        ClassStatus     @default(ENROLLMENTS_OPEN)
  startDate     DateTime        @map("start_date")
  endDate       DateTime?       @map("end_date")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  institution   Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  course        Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollments   Enrollment[]
  studyMaterials StudyMaterial[]
  classNotices  ClassNotice[]
  lives         Live[]

  @@index([institutionId], map: "classes_institution_idx")
  @@map("classes")
}

model Enrollment {
  id             String           @id @default(uuid()) @db.Uuid
  classId        String           @map("class_id") @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  institutionId  String           @map("institution_id") @db.Uuid
  status         EnrollmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  institution    Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  schoolClass    SchoolClass      @relation(fields: [classId], references: [id], onDelete: Cascade)
  student        User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  monthlyCharges MonthlyCharge[]

  @@unique([classId, studentId])
  @@index([institutionId], map: "enrollments_institution_idx")
  @@map("enrollments")
}

model MonthlyCharge {
  id                  String               @id @default(uuid()) @db.Uuid
  enrollmentId        String               @map("enrollment_id") @db.Uuid
  ownerAdminId        String?              @map("owner_admin_id") @db.Uuid
  dueDate             DateTime             @map("due_date")
  amount              Decimal              @db.Decimal(12, 2)
  status              ChargeStatus         @default(PENDING)
  externalChargeId    String?              @map("external_charge_id")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  enrollment          Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  ownerAdmin          User?                @relation("monthly_charge_owner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
  paymentTransactions PaymentTransaction[]

  @@unique([externalChargeId])
  @@index([ownerAdminId], map: "monthly_charges_owner_admin_idx")
  @@map("monthly_charges")
}

model PaymentTransaction {
  id                    String            @id @default(uuid()) @db.Uuid
  monthlyChargeId       String            @map("monthly_charge_id") @db.Uuid
  provider              String
  amount                Decimal           @db.Decimal(12, 2)
  status                TransactionStatus @default(PENDING)
  externalTransactionId String?           @map("external_transaction_id")
  paidAt                DateTime?         @map("paid_at")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  monthlyCharge         MonthlyCharge     @relation(fields: [monthlyChargeId], references: [id], onDelete: Cascade)

  @@unique([externalTransactionId])
  @@map("payment_transactions")
}

model WordpressPluginLicense {
  id             String                     @id @default(uuid()) @db.Uuid
  keyHash        String                     @unique @map("key_hash")
  label          String?
  maxActivations Int                        @default(1) @map("max_activations")
  isActive       Boolean                    @default(true) @map("is_active")
  expiresAt      DateTime?                  @map("expires_at")
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")
  activations    WordpressPluginActivation[]

  @@map("wordpress_plugin_licenses")
}

model WordpressPluginActivation {
  id              String                 @id @default(uuid()) @db.Uuid
  licenseId       String                 @map("license_id") @db.Uuid
  domain          String
  siteUrl         String?                @map("site_url")
  activationToken String                 @unique @map("activation_token")
  lastValidatedAt DateTime?              @map("last_validated_at")
  revokedAt       DateTime?              @map("revoked_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  license         WordpressPluginLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, domain], map: "wordpress_plugin_activations_license_domain_key")
  @@index([domain], map: "wordpress_plugin_activations_domain_idx")
  @@map("wordpress_plugin_activations")
}

enum LiveStatus {
  SCHEDULED @map("scheduled")
  LIVE      @map("live")
  ENDED     @map("ended")

  @@map("live_status")
}

model StudyMaterial {
  id            String      @id @default(uuid()) @db.Uuid
  classId       String      @map("class_id") @db.Uuid
  title         String
  description   String?
  fileUrl       String?     @map("file_url")
  externalUrl   String?     @map("external_url")
  mimeType      String?     @map("mime_type")
  kind          String      @default("file")
  publishedBy   String?     @map("published_by")
  publishedAt   DateTime    @default(now()) @map("published_at")
  expiresAt     DateTime?   @map("expires_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  schoolClass   SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId], map: "study_materials_class_idx")
  @@map("study_materials")
}

model ClassNotice {
  id          String      @id @default(uuid()) @db.Uuid
  classId     String      @map("class_id") @db.Uuid
  title       String
  body        String
  priority    String      @default("normal")
  publishedBy String?     @map("published_by")
  publishedAt DateTime    @default(now()) @map("published_at")
  expiresAt   DateTime?   @map("expires_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  views       ClassNoticeView[]

  @@index([classId], map: "class_notices_class_idx")
  @@map("class_notices")
}

model ClassNoticeView {
  id       String     @id @default(uuid()) @db.Uuid
  noticeId String     @map("notice_id") @db.Uuid
  userId   String     @map("user_id") @db.Uuid
  viewedAt DateTime   @default(now()) @map("viewed_at")
  notice   ClassNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId], map: "class_notice_views_notice_user_key")
  @@index([noticeId], map: "class_notice_views_notice_idx")
  @@index([userId], map: "class_notice_views_user_idx")
  @@map("class_notice_views")
}

model Live {
  id               String      @id @default(uuid()) @db.Uuid
  classId          String      @map("class_id") @db.Uuid
  title            String
  description      String?
  instructor       String?
  scheduledAt      DateTime    @map("scheduled_at")
  durationMinutes  Int?        @map("duration_minutes")
  status           LiveStatus  @default(SCHEDULED)
  streamUrl        String?     @map("stream_url")
  recordingUrl     String?     @map("recording_url")
  provider         String?
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  schoolClass      SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId], map: "lives_class_idx")
  @@index([status], map: "lives_status_idx")
  @@map("lives")
}

model WordpressPluginRelease {
  id             String   @id @default(uuid()) @db.Uuid
  version        String   @unique
  packageUrl     String   @map("package_url")
  checksumSha256 String?  @map("checksum_sha256")
  changelogUrl   String?  @map("changelog_url")
  minWpVersion   String?  @map("min_wp_version")
  minPhpVersion  String?  @map("min_php_version")
  isPublished    Boolean  @default(false) @map("is_published")
  isMandatory    Boolean  @default(false) @map("is_mandatory")
  publishedAt    DateTime? @map("published_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("wordpress_plugin_releases")
}

model SystemSetting {
  key   String @id
  value String

  @@map("system_settings")
}
