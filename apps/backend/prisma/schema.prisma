  @@index([ownerAdminId], map: "finance_vouchers_owner_admin_idx")
  @@index([courseId, active], map: "finance_vouchers_course_active_idx")
  @@map("finance_vouchers")
}

model MonthlyCharge {
  id                  String               @id @default(uuid()) @db.Uuid
  enrollmentId        String               @map("enrollment_id") @db.Uuid
  ownerAdminId        String?              @map("owner_admin_id") @db.Uuid
  dueDate             DateTime             @map("due_date")
  amount              Decimal              @db.Decimal(12, 2)
  kind                MonthlyChargeKind     @default(COURSE_PAYMENT)
  status              ChargeStatus         @default(PENDING)
  externalChargeId    String?              @map("external_charge_id")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  enrollment          Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  ownerAdmin          User?                @relation("monthly_charge_owner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
  paymentTransactions PaymentTransaction[]
  creditCardPaymentRequests CreditCardPaymentRequest[]

  @@unique([externalChargeId])
  @@index([ownerAdminId], map: "monthly_charges_owner_admin_idx")
  @@map("monthly_charges")
}

model CreditCardPaymentRequest {
  id                String                         @id @default(uuid()) @db.Uuid
  monthlyChargeId   String?                        @map("monthly_charge_id") @db.Uuid
  enrollmentId      String?                        @map("enrollment_id") @db.Uuid
  studentCourseId   String?                        @map("student_course_id") @db.Uuid
  studentId         String                         @map("student_id") @db.Uuid
  ownerAdminId      String?                        @map("owner_admin_id") @db.Uuid
  institutionId     String                         @map("institution_id") @db.Uuid
  amount            Decimal                        @db.Decimal(12, 2)
  kind              MonthlyChargeKind              @default(COURSE_PAYMENT)
  installmentCount  Int?                           @map("installment_count")
  installmentAmount Decimal?                       @map("installment_amount") @db.Decimal(12, 2)
  status            CreditCardPaymentRequestStatus @default(REQUESTED)
  paymentLinkUrl    String?                        @map("payment_link_url")
  adminNote         String?                        @map("admin_note")
  requestedAt       DateTime                       @default(now()) @map("requested_at")
  linkSentAt        DateTime?                      @map("link_sent_at")
  viewedAt          DateTime?                      @map("viewed_at")
  copiedAt          DateTime?                      @map("copied_at")
  approvedAt        DateTime?                      @map("approved_at")
  approvedByUserId  String?                        @map("approved_by_user_id") @db.Uuid
  createdAt         DateTime                       @default(now()) @map("created_at")
  updatedAt         DateTime                       @updatedAt @map("updated_at")
  monthlyCharge     MonthlyCharge?                 @relation(fields: [monthlyChargeId], references: [id], onDelete: SetNull)
  enrollment        Enrollment?                    @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  studentCourse     StudentCourse?                 @relation(fields: [studentCourseId], references: [id], onDelete: SetNull)
  student           User                           @relation("credit_card_payment_request_student", fields: [studentId], references: [id], onDelete: Cascade)
  ownerAdmin        User?                          @relation("credit_card_payment_request_owner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
  institution       Institution                    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  approvedBy        User?                          @relation("credit_card_payment_request_approved_by", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@unique([monthlyChargeId], map: "credit_card_payment_requests_charge_key")
  @@unique([studentCourseId, kind], map: "credit_card_payment_requests_student_course_kind_key")
  @@index([ownerAdminId, status], map: "credit_card_payment_requests_owner_status_idx")
  @@index([studentId, status], map: "credit_card_payment_requests_student_status_idx")
  @@index([institutionId, requestedAt], map: "credit_card_payment_requests_institution_requested_idx")
  @@map("credit_card_payment_requests")
}

model PaymentTransaction {
  id                    String            @id @default(uuid()) @db.Uuid
  monthlyChargeId       String            @map("monthly_charge_id") @db.Uuid
  provider              String
  amount                Decimal           @db.Decimal(12, 2)
  status                TransactionStatus @default(PENDING)
  externalTransactionId String?           @map("external_transaction_id")
  paidAt                DateTime?         @map("paid_at")
