{
  "name": "frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "sync:templates": "node scripts/sync-templates.mjs",
    "sync:templates:force": "node scripts/sync-templates.mjs --force",
    "build:templates:css": "tailwindcss -c tailwind.templates.config.cjs -i ./src/templates.css -o ./public/templates/assets/templates.bundle.css --minify",
    "predev": "npm run sync:templates && npm run build:templates:css",
    "dev": "vite",
    "prebuild": "npm run sync:templates && npm run build:templates:css",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "vite": "^8.0.1"
  }
}
